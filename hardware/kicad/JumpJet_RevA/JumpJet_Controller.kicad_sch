  (text "ESP32-S3 SUPERMINI CARRIER (MEASURED 2x9 BOARD)" (at 18.0 22.0 0)
    (effects (font (size 1.80 1.80) (thickness 0.225)) (justify left bottom))
    (uuid 00c60e9d-01b2-4633-8b13-504f6e1fe6d2)
  )
  (text "U2 edge-pad order matches the photographed S3 board. GPIO3 is a strapping pin and is intentionally unused."
    (at 28.00 118.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid 989d1c1b-e73b-4557-9840-8d28f49f2f69)
  )
  (text "+5V_MCU is the measured Super Mini 5V/USB-VBUS tied node. D4 and SW1 on the power sheet isolate its board-derived feed from +5V_SYS_GATE for USB service."
    (at 28.00 124.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid d7a12df2-cad0-4bf1-bfb7-709f03e42f5f)
  )
  (text "LEGACY_HTR_PWM_NC preserves the historical physical mapping only; HEATER_PWM_CMD and HEATER_GATE_EN have no assigned GPIO."
    (at 28.00 130.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid 5397c9d8-4358-4c42-ae52-702dd108aa65)
  )

