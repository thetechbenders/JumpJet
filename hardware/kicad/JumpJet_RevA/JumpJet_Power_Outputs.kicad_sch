  (text "24 V INPUT, PROTECTION, AND LOGIC POWER" (at 18.0 22.0 0)
    (effects (font (size 1.80 1.80) (thickness 0.225)) (justify left bottom))
    (uuid 35f7f43e-ad43-476c-8fd0-7eb41fba3c3a)
  )
  (text "MOD1 is the shared LMR36520 candidate feeding +5V_SYS_GATE. D4 reverse-blocks the MCU branch; SW1 selects RUN or physical USB SERVICE isolation. Exact parts/footprints remain TBD."
    (at 23.00 92.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid 7f86481b-c093-4c97-83e9-606d5d071579)
  )
  (text "Heater OE defaults disabled; Q_GATE_EN requires explicit MCU assertion. USB-only power cannot source +5V_SYS_GATE."
    (at 150.00 174.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid b59cd9c9-fcc4-462d-b06a-d4a2a3106217)
  )
  (text "F1 and D1 values are provisional; coordinate with PSU behavior and measured PTC inrush."
    (at 23.00 98.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid b608ab78-44cf-486a-b5dd-6ab3ef126e7c)
  )
  (text "HEATER + FOUR-WIRE FAN OUTPUTS" (at 152.62 22.0 0)
    (effects (font (size 1.80 1.80) (thickness 0.225)) (justify left bottom))
    (uuid bcd2022d-b38f-417c-87e7-ca6ea3cb4589)
  )
  (text "Fan: continuous fused 24 V + GND; separate open-drain PWM and 3.3 V tach interface."
    (at 150.00 180.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid eab4d0bb-5495-40fc-aa49-ad112c75465b)
  )
  (text "TF1 and TS1 are physically mounted at the heater hot spot and interrupt only the heating element."
    (at 150.00 186.00 0)
    (effects (font (size 0.95 0.95) (thickness 0.120)) (justify left bottom))
    (uuid efadd267-eef7-4648-9d7b-c0ed698f7488)
  )

